{
	"name": "midnite",
	"version": "1.0.0",
	"private": true,
	"type": "module",
	"description": "Pi extension that reminds you to sleep once between midnight and 06:00.",
	"scripts": {
		"demo": "tsx demo.ts",
		"test": "vitest --run",
		"test:watch": "vitest",
		"test:list": "tsx test-runner.ts --list",
		"test:run": "tsx test-runner.ts --all",
		"test:failed": "tsx test-runner.ts --failed"
	},
	"devDependencies": {
		"@types/node": "^26.6.2",
		"tsx": "^4.19.0",
		"typescript": "^5.6.0",
		"vitest": "^2.1.9"
	}
}
